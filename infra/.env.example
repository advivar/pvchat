# Configuration PostgreSQL pour PVCHAT
DB_USER=pvchat_user
DB_PASSWORD=pvchat_password_secret
DB_NAME=pvchat_db

# Cle secrete pour signer les tokens JWT (OBLIGATOIRE : a changer par une chaine aleatoire forte)
JWT_SECRET=generer_une_cle_secrete_aleatoire_et_longue_ici

# Port web externe (optionnel, 9080 par defaut)
WEB_PORT=9080
